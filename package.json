{
  "name": "codetrack",
  "displayName": "CodeTrack",
  "description": "Track time spent on code files and count lines",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "axios": "^1.8.4"
  },
  "contributes": {
    "configuration": {
      "title": "CodeTrack",
      "properties": {
        "codetrack.apiToken": {
          "type": "string",
          "default": "",
          "description": "Token API pour l'envoi des données de suivi"
        },
        "codetrack.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000/api",
          "description": "URL de base de l'API CodeTrack"
        },
        "codetrack.apiKey": {
          "type": "string",
          "default": "",
          "description": "Clé API pour l'authentification auprès du serveur"
        },
        "codetrack.inactivityThreshold": {
          "type": "number",
          "default": 2,
          "description": "Délai d'inactivité en minutes avant que le temps ne soit plus comptabilisé"
        }
      }
    },
    "commands": [
      {
        "command": "codetrack.showStats",
        "title": "CodeTrack: Afficher les statistiques"
      },
      {
        "command": "codetrack.setUserId",
        "title": "CodeTrack: Définir l'ID utilisateur"
      },
      {
        "command": "codetrack.setApiKey",
        "title": "CodeTrack: Définir la clé API"
      }
    ],
    "keybindings": [
      {
        "command": "codetrack.showStats",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-cli",
    "copy-cli": "node scripts/copy-cli.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "@typescript-eslint/parser": "^5.30.0",
    "eslint": "^8.13.0",
    "typescript": "^4.7.2"
  }
}
